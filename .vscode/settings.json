{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "hide-files.files": [],

    "editor.suggest.sortOrder": "recentlyUsedByPrefix",
    "editor.suggest.showInlineDetails": true,
    // "editor.suggest.maxVisibleSuggestions": 20, ← удалено
    "gopls": {
        "ui.completion.matcher": "Fuzzy"
    }
    
}