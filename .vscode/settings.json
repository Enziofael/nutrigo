{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "docker-compose.yaml": true,
        ".gitignore": true,
        ".env.example": true,
        ".vscode": true,
        "shared/api-models": true,
        "shared/domain-models": true,
        "shared/gflog": true,
        "shared/go.mod": true,
        "shared/go.sum": true,
        "backend/internal/migrations/postgresql": true,
        "[!f]*/**": true,
        "f[!r]*/**": true,
        "fr[!o]*/**": true,
        "fro[!n]*/**": true,
        "fron[!t]*/**": true,
        "front[!e]*/**": true,
        "fronte[!n]*/**": true,
        "fronten[!d]*/**": true,
        "frontend[!-]*/**": true,
        "frontend-[!b]*/**": true,
        "frontend-b[!o]*/**": true,
        "frontend-bo[!t]*/**": true
    },
    "hide-files.files": [
        "docker-compose.yaml",
        ".gitignore",
        ".env.example",
        ".vscode",
        "shared/api-models",
        "shared/domain-models",
        "shared/gflog",
        "shared/go.mod",
        "shared/go.sum",
        "backend/internal/migrations/postgresql"
    ]
    
}